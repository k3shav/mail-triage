{
  "name": "mail-triage",
  "version": "0.1.0",
  "description": "Gmail-first email classifier with configurable categories, separate action and priority decisions, and explicit review before labels change.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server/main.ts",
    "start": "node dist/node/server/main.js",
    "cli": "node dist/node/cli/index.js",
    "classify": "tsx src/cli/classify-file.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.92",
    "ai": "^7.0.173",
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "bin": {
    "mail-triage": "dist/node/cli/index.js"
  }
}
