{
  "name": "mail-triage",
  "version": "0.1.0",
  "description": "Background Gmail labeler: classifies new mail into your own categories plus separate action and priority, and adds namespaced labels in Gmail.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs clean && tsc -p tsconfig.build.json && node scripts/build.mjs assets",
    "dev": "tsx watch --env-file-if-exists=.env src/server/main.ts",
    "start": "node --env-file-if-exists=.env dist/node/server/main.js",
    "cli": "node --env-file-if-exists=.env dist/node/cli/index.js",
    "classify": "tsx --env-file-if-exists=.env src/cli/classify-file.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.92",
    "ai": "^7.0.173",
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "bin": {
    "mail-triage": "dist/node/cli/index.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    ".env.example"
  ]
}
