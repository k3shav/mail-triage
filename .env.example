# Mail Triage configuration. Copy to .env and fill in what you use.
# Secrets stay on the server; the browser never receives them.

# --- Tagging ------------------------------------------------------------------
# dry-run: sync, classify, and report what would change; never writes to Gmail.
# apply:   add labels in Gmail. Requires GMAIL_LABEL_WRITES=true and a Gmail
#          connection that granted gmail.modify; otherwise cycles fail clearly.
TAGGING_MODE=dry-run
# How often the server runs a cycle, in seconds (15-86400). 0 turns the server's
# own polling off, for example when you schedule "mail-triage tag" yourself.
# POLL_INTERVAL_SECONDS=120
# Answers with provider confidence below this get only "<prefix>/Needs Review".
# CONFIDENCE_THRESHOLD=0.7
# Local models report no confidence. false: those messages get only Needs Review.
# true: also add their category/action/priority labels (still with Needs Review).
# AUTO_LABEL_UNSCORED=false
# JSON file with your categories (see examples/categories.json). Reloaded before
# every cycle; an invalid file leaves the saved categories untouched.
# CATEGORIES_FILE=./my-categories.json
# LABEL_PREFIX=Mail Triage
# 1-200 newest inbox messages listed per cycle; only new ones are downloaded
# SYNC_MAX_MESSAGES=50
# 1-100 messages classified per cycle
# CLASSIFY_BATCH_SIZE=20
# CLASSIFY_CONCURRENCY=3
# 1-200 messages labeled per cycle
# TAG_BATCH_SIZE=50

# --- Model provider -------------------------------------------------------------
# One of: jev | openai | openai-compatible. Required for tagging.
# MODEL_PROVIDER=jev
# defaults: jev-latest (jev), gpt-6-luna (openai); required for openai-compatible
# MODEL_NAME=
# MODEL_TIMEOUT_MS=20000
# MODEL_MAX_RETRIES=2

# Jev System One (TypeSafe). Email text is sent to this cloud service.
# JEV_API_KEY=
# JEV_BASE_URL=https://api.typesafe.ai

# OpenAI Decisions API. Email text is sent to this cloud service.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT=

# OpenAI-compatible server via the Vercel AI SDK (Ollama, LM Studio, ...).
# With a local server, email text stays on your machine.
# Ollama
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# LM Studio
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_STRUCTURED_OUTPUTS=true

# --- Gmail ------------------------------------------------------------------------
# Google Cloud OAuth client of type "Web application".
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Exact redirect URI registered on the client. Defaults to <PUBLIC_URL>/api/gmail/oauth/callback.
# GOOGLE_REDIRECT_URI=http://localhost:8787/api/gmail/oauth/callback
# 32 random bytes; encrypts the Gmail refresh token at rest. Generate: openssl rand -base64 32
# Changing it later requires reconnecting Gmail.
# MAIL_TRIAGE_ENCRYPTION_KEY=
# false: request gmail.readonly only (dry-run works; apply does not).
# true: also request gmail.labels and gmail.modify so labels can be added.
# Reconnect Gmail after changing it.
GMAIL_LABEL_WRITES=false

# --- Setup page server ------------------------------------------------------------
# Loopback (127.0.0.1) is the default. Any other bind address requires APP_PASSWORD.
HOST=127.0.0.1
PORT=8787
# The URL you open in the browser. Defaults to http://localhost:<PORT>.
# Must be https when it is not a loopback address.
# PUBLIC_URL=https://mail.example.com
# Required for non-loopback binds (including Docker). At least 12 characters.
# APP_PASSWORD=
# Set to true when a reverse proxy terminates TLS in front of the app.
# TRUST_PROXY=false
# SESSION_TTL_HOURS=168
# false: serve only /api/health and the API (no setup page).
# SETUP_PAGE=true
DATA_DIR=./data
# DATABASE_PATH=./data/mail-triage.sqlite
